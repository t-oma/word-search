    "isbot": "^5.1.35",
    "lucide-react": "^0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.1",
    "rehype-raw": "^7.0.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
